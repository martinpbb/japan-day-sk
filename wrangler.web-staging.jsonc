{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanday-sk-web-staging",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
