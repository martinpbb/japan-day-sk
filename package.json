{
  "name": "japonsky-den-povazska-bystrica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner && node scripts/seo/generate-static-routes.mjs",
    "preview": "vite preview --configLoader runner",
    "lint": "eslint .",
    "ai:state": "node .agents/skills/japanese-day-handoff/scripts/collect-state.mjs --format markdown",
    "ai:validate": "node .agents/skills/japanese-day-handoff/scripts/validate-install.mjs",
    "ai:graph:query": "graphify query",
    "ai:graph:build": "graphify extract . --code-only",
    "ai:graph:update": "graphify update .",
    "seo:generate": "node scripts/seo/generate-static-routes.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --grep @smoke --project=chromium",
    "test:e2e:ui": "playwright test --grep @ui --project=chromium",
    "test:e2e:seo": "playwright test --grep @seo --project=chromium",
    "test:e2e:a11y": "playwright test --grep @a11y --project=chromium",
    "test:e2e:responsive": "playwright test --grep @responsive --project=chromium",
    "test:e2e:visual": "playwright test --grep @visual --project=chromium",
    "test:e2e:production": "set BASE_URL=https://japanday.sk&& playwright test --grep \"@production\" --project=chromium",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
